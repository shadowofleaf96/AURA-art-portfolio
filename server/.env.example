# Server Port
PORT=5000

# PostgreSQL Connection String (Aiven / Neon)
DATABASE_URL=postgres://avnadmin:password@hostname:port/defaultdb?sslmode=require

# JWT Secret for Session Signing
JWT_SECRET=aura_portfolio_super_secret_jwt_key_2026

# Allowed Frontend URL for CORS & Stripe Redirects (in production: your Vercel URL)
CLIENT_URL=http://localhost:5173

# Stripe Payment Keys (Test Mode)
# Obtain from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Secret (from Stripe CLI: stripe listen --forward-to localhost:5000/api/checkout/webhook)
# In production: from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
