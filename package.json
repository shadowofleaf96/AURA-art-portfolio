{
  "name": "aura-photography-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Fullstack Photography & Fine Art Portfolio (React + Tailwind + Node/Express + PostgreSQL MVC)",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "start": "npm --prefix server start",
    "start:server": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
