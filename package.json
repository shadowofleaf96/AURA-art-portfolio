{
  "name": "aura-photography-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Fullstack Photography & Fine Art Portfolio (React + Tailwind + Node/Express + PostgreSQL MVC)",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "start": "cd server && npm start",
    "start:server": "cd server && npm start",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "seed": "cd server && npm run seed",
    "install:all": "cd server && npm install && cd ../client && npm install"

  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
