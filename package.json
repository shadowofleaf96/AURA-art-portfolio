{
  "name": "aura-photography-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Fullstack Photography & Fine Art Portfolio (React + Tailwind + Node/Express + PostgreSQL MVC)",
  "scripts": {
    "dev": "cd server && npm run dev",
    "dev:stripe": "cd server && npm run dev:stripe",
    "start": "cd server && npm start",
    "start:server": "cd server && npm start",
    "start:stripe": "cd server && npm run start:stripe",
    "stripe": "cd server && npm run stripe",
    "seed": "cd server && npm run seed",
    "migrate": "cd server && npm run migrate",
    "test:payments": "cd server && npm run test:payments",
    "build": "cd client && npm run build",
    "install:all": "cd server && npm install && cd ../client && npm install"
  }
}
